# KataGo — copia aquest fitxer a .env.local (local) o exporta'l al servidor.
# Sense aquestes variables, l'app funciona igualment amb el bot heurístic de
# reserva; amb elles, l'oponent és KataGo.

# Ruta de l'executable de KataGo (si és al PATH, deixa "katago").
KATAGO_BIN=katago

# Ruta del model (xarxa neuronal) .bin.gz descarregat.
# Per gastar menys RAM, un net més petit (b10/b6) va molt bé en 9x9; es baixen
# de la pàgina de xarxes de katagotraining.org.
KATAGO_MODEL=/opt/katago/models/g170e-b20c256x2-s5303129600-d1228401921.bin.gz

# Ruta del fitxer de configuració del motor d'anàlisi (ajusta-la a la teva instal·lació).
KATAGO_CONFIG=/ruta/al/repo/katago-config/analysis.cfg
